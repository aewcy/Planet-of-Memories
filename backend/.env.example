# 各自的生日暗号映射（格式：生日暗号:显示名字:星光颜色，英文逗号分隔）
PASSCODE_MAP=1124:寿星:#89b4fa,0724:我:#f6c177,0808:好友:#94e2d5
ADMIN_PASSCODE=admin1123
SENDER_NAME=我

# 多模态 AI 配置（支持 OpenAI 兼容格式，包括 Gemini OpenAI 兼容接口 / OpenAI / 通义千问等）
# 如果留空，系统会以「预览模拟模式」运行，方便你先调通界面与流程
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3-flash-preview

# 服务端口与数据目录
HOST=0.0.0.0
PORT=8000
